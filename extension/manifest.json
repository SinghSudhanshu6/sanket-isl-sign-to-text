{
  "manifest_version": 3,
  "name": "Sanket - sign into any text box",
  "version": "0.3.0",
  "description": "Sign in Indian Sign Language; Sanket forms a sentence and types it into the text box you are using on any website - WhatsApp Web, Instagram, Google, ChatGPT, Claude, Gemini and more - then can simplify replies. Works offline. Camera is processed on-device.",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Sanket"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
